VITE_API_URL=http://localhost:5000/api/v1

# Préfixe des pages réservées (inscription + espace de gestion).
# Exemple : k7m4x9q2  ->  /k7m4x9q2/register, /k7m4x9q2/dashboard, ...
#
# À définir dans les variables d'environnement du BUILD (sur Render :
# Environment > ton service frontend/monorepo), jamais dans un fichier commité,
# le dépôt étant public. Sans valeur, l'application utilise les chemins
# historiques (/register, /dashboard) et fonctionne normalement.
#
# Ce n'est pas un mot de passe : cela masque les URL, sans les protéger.
# La sécurité réelle reste assuré par le serveur (plafond de tentatives sur
# l'API, vérification email obligatoire, JWT).
VITE_APP_KEY=