# Database (SQLite par défaut - fichier local backend/prisma/dev.db)
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# Ariari (https://ariari.mg/docs - ariari.mg → projet → "secret") — valeurs réelles dans .env uniquement (jamais commitées)
ARIARI_API_URL="https://api.ariari.mg"
ARIARI_SECRET="<SECRET_API_ARIARI>"
ARIARI_WEBHOOK_URL="https://MON-DOMAINE.com/api/webhooks/ariari"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# WhatsApp OTP via Baileys (AUCUNE API payante) — canal OPTIONNEL
# 0 = désactivé (repli e-mail seul, défaut sûr) | 1 = activé
WHATSAPP_OTP_ENABLED=0
# Votre numéro = EXPÉDITEUR des OTP WhatsApp (le client reçoit sur SON numéro)
WHATSAPP_SENDER_NUMBER="+261326321784"
# Appairage initial (une seule fois) : GET /api/v1/admin/whatsapp/qr (superadmin)
# → WhatsApp sur le téléphone → Appareils liés → scanner le QR.
# La session est ensuite persistée en base (table whatsapp_kv) : plus besoin
# de rescanner après chaque redéploiement Render.
